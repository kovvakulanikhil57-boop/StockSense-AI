# ==============================================================================
# StockSense AI — Backend Environment Configuration Example
# ==============================================================================

PORT=5000
NODE_ENV=development

# --- MariaDB / MySQL Configuration (Active Fallback) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stocksense_db

# --- Supabase PostgreSQL Configuration (Target Database) ---
# Direct connection string or transaction pooler URI from Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Alternatively, discrete parameters:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# --- JWT Authentication ---
# Generate a unique, random secret before starting the backend.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Institutional Policies ---
INSTITUTION_EMAIL_DOMAIN=example.test
DELIVERY_THRESHOLD_MINUTES=30
OTP_EXPIRY_MINUTES=15
MAX_OTP_ATTEMPTS=5
CLIENT_ORIGIN=http://localhost:5173
